    "16545061113a9e8333": {
      "type": "faq",
      "blocks": {
        "165450611101e471f9-4": {
          "type": "question",
          "settings": {
            "title": "How do I know whether your watches are authentic?",
            "answer": "<p>As the largest buyer, seller, and trader of high-end luxury watches in Indonesia, you can be confident that any watch you see on Omniluxe is guaranteed to be authentic. We have team experts to verify the authenticity of every timepiece.</p>"
          }
        },
        "a91b97e9-fe57-469a-adbb-f609f487448a": {
          "type": "question",
          "settings": {
            "title": "Does Omniluxe have shipping insurance for the watch I bought?",
            "answer": "<p>We will protect your treasured timepiece with a fully insured benefit.</p>"
          }
        },
        "5fdce758-e660-4a45-81f5-86ba336e81b5": {
          "type": "question",
          "settings": {
            "title": "Can I order watches that are not listed on your website?",
            "answer": "<p>Yes, you may contact us to enquire about the watch you’re looking for.</p>"
          }
        },
        "da113489-cb22-4563-9198-128122fe4851": {
          "type": "question",
          "settings": {
            "title": "Can I offer a lower price for a watch?",
            "answer": "<p>Many of the watches on our website have the ability for you to make an offer. We strive to respond to your offer as quickly as possible during business<br/>hours (11.00 A.M – 7.30 P.M)</p>"
          }
        },
        "937937f1-7e0e-4608-95cd-bb04a48c5074": {
          "type": "question",
          "settings": {
            "title": "Why is the manufacturer retail price lower than your price?",
            "answer": "<p>High demand watches that produced by the retailer have a higher value on the secondary market. Omniluxe works very hard to give you an easiest access to the most popular watches at a fair market price.</p>"
          }
        },
        "a8d724c5-c5fb-46b9-a8ab-1c3c69b396f0": {
          "type": "question",
          "settings": {
            "title": "Does Omniluxe has an Offline Store?",
            "answer": "<p>We’re located in Jakarta. You can visit us at Mall Artha Gading GF/B07/09, Jl. Artha Gading Sel. No.1, Jakarta, Daerah Khusus Ibukota Jakarta 14240</p>"
          }
        },
        "b48f986d-79ad-4acd-908a-d6ed7f5745ff": {
          "type": "question",
          "settings": {
            "title": "Can I see a watch in person before purchasing it?",
            "answer": "<p>Yes, we will welcome you warmly at our store. In spite of that, if you are keen to buy the Consignment Item, you have to make a Down Payment first before we arrange delivery of watch from the owner.</p>"
          }
        },
        "ae6c5ea0-1645-429e-8170-0f6fa484e5a9": {
          "type": "question",
          "settings": {
            "title": "What types of payments do you accept?",
            "answer": "<p>Our preferred method of payment are by Cash or Transfer. We also accept Credit Cards,and  Debit Cards.</p>"
          }
        },
        "e1fc9db6-e1d4-4bca-98dd-bcffa821e04e": {
          "type": "question",
          "settings": {
            "title": "What happens if my watch has an issue? What is your Warranty?",
            "answer": "<p>Every watch we sell comes with store warranty*. We will provide coverage for the remaining time within the 30 days period (*Terms & Conditions Apply).</p>"
          }
        },
        "165450611101e471f9-0": {
          "type": "category",
          "settings": {
            "title": "Shipping"
          }
        },
        "165450611101e471f9-1": {
          "type": "question",
          "settings": {
            "title": "Do you ship outside Java Islands?",
            "answer": "<p>Yes, we ship domestically. Shipping costs will apply, and will be added at checkout. We run discounts and promotions all year, so stay tuned for exclusive deals.</p>"
          }
        },
        "165450611101e471f9-2": {
          "type": "question",
          "settings": {
            "title": "How long will it take to get my order?",
            "answer": "<p>It depends on where you are. Orders processed in JABODETABEK  will take maximum 1 business days to arrive. Overseas deliveries can take anywhere from 7-16 days. Delivery details will be provided in your confirmation email.</p>"
          }
        }
