    "1662623357b84977bc": {
      "type": "faq",
      "blocks": {
        "1662623357c26a6f93-1": {
          "type": "question",
          "settings": {
            "title": "What is consignment?",
            "answer": "<p>Consignment is a service that allows you to sell your luxury watch through our platform, Omniluxe. We handle the marketing, promotion, and sale process, ensuring a seamless experience for you. Consignment is a hassle-free way to reach a broad audience and maximize the value of your luxury timepiece.</p>"
          }
        },
        "1662623357c26a6f93-2": {
          "type": "question",
          "settings": {
            "title": "How do I start consigning?",
            "answer": "<p>To start consigning, first contact our consignment admin via the WhatsApp button on your bottom of the screen or you can simply visit our offline store. </p><p>Then, register as a seller on our platform. Our admin will guide you to drop off your watch at our store for inspection.</p>"
          }
        },
        "1662623357c26a6f93-4": {
          "type": "question",
          "settings": {
            "title": "Where is your store?",
            "answer": "<p>Our store is named <strong>OMNILUXE</strong>, located at </p><p>Mall Artha Gading, Ground Floor B07/09, </p><p>Jakarta Utara 14240, Indonesia.</p>"
          }
        },
        "ae8dd18e-d7b9-4ae6-b524-47804791b99a": {
          "type": "question",
          "settings": {
            "title": "What brands are accepted?",
            "answer": "<p>We accept a wide range of luxury watch brands, including Rolex, Patek Philippe, Audemars Piguet, Omega, and more. If you're unsure whether your watch qualifies, please contact us for details.</p>"
          }
        },
        "94ce80df-d2df-4640-8b29-6bec46ae52c6": {
          "type": "question",
          "settings": {
            "title": "What conditions are accepted?",
            "answer": "<p>We accept luxury watches in various conditions, from new to used. However, the watch must be authentic and complete with its original box and papers. If you have any questions about your watch’s condition, feel free to reach out to us.</p>"
          }
        },
        "de38eec1-39d9-4c99-94d8-3e4c9f963ddf": {
          "type": "question",
          "settings": {
            "title": "Is there any consignment admin fee?",
            "answer": "<p>Yes, there is an admin fee of <strong>IDR 1 Mio</strong> or <strong>Rp 1,000,000</strong> per item.</p><p>This fee covers the cost of listing and promoting your watch on our platform.</p>"
          }
        },
        "question_m94yC9": {
          "type": "question",
          "settings": {
            "title": "How do I set the selling price for my watch?",
            "answer": "<p>You can define your own selling price for the watch, but we recommend aligning with current market prices. Our Omniluxe team, experts in market trends, will assist you to determine a competitive price after evaluate the watch and its condition.</p><p>But if you are in a hurry, we'll recommend you to choose a price slightly below market value.</p>"
          }
        },
        "question_tiDAJP": {
          "type": "question",
          "settings": {
            "title": "How does Omniluxe market the watch?",
            "answer": "<p>Omniluxe markets your watch by creating high-quality content and showcasing it on our website and social media platforms, including Instagram. We use professional photography and engaging descriptions to attract potential buyers and maximize visibility.</p>"
          }
        },
        "question_mjGLbt": {
          "type": "question",
          "settings": {
            "title": "How long until my watch is sold?",
            "answer": "<p>The time it takes to sell your watch can vary depending on market demand and pricing. While some watches may sell quickly, others might take a bit longer.</p><p>Typically, it takes about 1 week to 1 month, but it can also sell within a few days or even within a day. We strive to ensure your watch gets the best exposure to facilitate a swift sale.</p>"
          }
        },
        "question_BrhJ8j": {
          "type": "question",
          "settings": {
            "title": "How will I know if my watch has been sold?",
            "answer": "<p>We will contact you if there is any offer for your watch. Once we agree on the offer, we will arrange the sale process for you. After the sale is complete, you can relax at home while we handle the payment, which will be processed as soon as possible, minus a 2% commission.</p>"
          }
        }
      },
